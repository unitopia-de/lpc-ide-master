{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LPC-IDE-Master Configuration",
  "description": "Konfiguration für Dialekt und Mudlib-Spezifikationen.",
  "type": "object",
  "required": ["dialect", "mudlib"],
  "definitions": {
    "mudConsole": {
      "type": "object",
      "required": ["host"],
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "description": "Default 4711 (telnet) bzw. 992 (telnets)." },
        "protocol": { "type": "string", "enum": ["telnet", "telnets"], "default": "telnet" }
      }
    }
  },
  "properties": {
    "dialect": {
      "type": "string",
      "enum": ["ldmud", "fluffos"],
      "description": "Der LPC-Driver-Dialekt."
    },
    "version": {
      "type": "string",
      "description": "Driver-Version, z.B. 3.5.0 oder 3.6.x."
    },
    "mudlib": {
      "type": "object",
      "required": ["name", "baseDir"],
      "properties": {
        "name": { "type": "string" },
        "baseDir": { "type": "string" },
        "simulEfunFile": { "type": "string" },
        "includeDirs": { "type": "array", "items": { "type": "string" } },
        "efunDefinitions": { "type": "string" },
        "indexFile": {
          "type": "string",
          "default": "/doc/lpc-ide/index.json.gz",
          "description": "Mudlib-Index (vom Index-Generator erzeugt) als Mudlib-Pfad. Wird aus dem homemud gelesen oder per FTP geladen und lokal zwischengespeichert."
        }
      }
    },
    "ftp": {
      "type": "object",
      "description": "Optionale FTP-Verbindungsdaten. Passwörter werden NICHT hier gespeichert.",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "description": "Default 21 (ftp/ftps), 990 (ftps-implicit), 22 (sftp)." },
        "user": { "type": "string" },
        "remoteRoot": { "type": "string" },
        "protocol": {
          "type": "string",
          "enum": ["ftp", "ftps", "ftps-implicit", "sftp"],
          "default": "ftps",
          "description": "ftp=plain, ftps=explicit AUTH TLS, ftps-implicit=TLS ab Verbindungsbeginn, sftp=SSH-basiert."
        },
        "tls": {
          "type": "object",
          "description": "Nur für ftps/ftps-implicit. Optionen für die TLS-Schicht.",
          "properties": {
            "rejectUnauthorized": {
              "type": "boolean",
              "default": true,
              "description": "Default true (strikte Zertifikatsprüfung). Auf false setzen, um selbst-signierte Zertifikate zu akzeptieren."
            }
          }
        },
        "allowSeparateTransferHost": {
          "type": "boolean",
          "default": false,
          "description": "Nur für ftp/ftps/ftps-implicit. Auf true setzen, wenn der Server per PASV eine andere IP für Datenverbindungen meldet als die der Steuerverbindung. Default false (Schutz vor FTP-Bounce-Angriffen)."
        }
      }
    },
    "mud": {
      "$ref": "#/definitions/mudConsole",
      "description": "Telnet-/Telnets-Verbindung zum REMOTE MUD, geöffnet als Terminal in VS Code."
    },
    "homemud": {
      "type": "object",
      "description": "Optional: lokales Entwicklungs-MUD im Workspace. Erlaubt Sync zwischen remote und lokalem MUD.",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Workspace-relativer Pfad zum lokalen MUD-Verzeichnis."
        },
        "libPath": {
          "type": "string",
          "default": "/lib",
          "description": "Pfad zur Mudlib innerhalb von path."
        },
        "mud": {
          "$ref": "#/definitions/mudConsole",
          "description": "Optional: Telnet-Terminal zum lokalen MUD."
        }
      }
    }
  }
}
